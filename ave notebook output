[32m+[m[32m    "def z_score(ser):\n",[m
[32m+[m[32m    "    return (ser - ser.mean()) / ser.std(ddof=0)\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "def add_post_redemption(grades_combined):\n",[m
[32m+[m[32m    "    out = grades_combined.copy()\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    mid_col = out.filter(like='Midterm').columns[0]\n",[m
[32m+[m[32m    "    mid = out[mid_col].fillna(0)\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    mid_z = z_score(mid)\n",[m
[32m+[m[32m    "    red_z = z_score(out['Raw Redemption Score'])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    mean_mid = mid.mean()\n",[m
[32m+[m[32m    "    std_mid = mid.std(ddof=0)\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    redeemed = red_z * std_mid + mean_mid\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    post = mid.where(red_z <= mid_z, redeemed)\n",[m
[32m+[m[32m    "    post = post.clip(0, 1)\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    out['Midterm Score Pre-Redemption'] = mid\n",[m
[32m+[m[32m    "    out['Midterm Score Post-Redemption'] = post\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "    return out"[m
